{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Elucim App",
  "version": "0.1.0",
  "identifier": "com.elucim.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3300",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Elucim App",
        "label": "main",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "GraphicsAndDesign",
    "shortDescription": "Desktop editor for Elucim diagrams and scenes",
    "longDescription": "Elucim App is a desktop editor for final-tuning Elucim diagrams, animations, and scenes.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["elc"],
        "name": "Elucim Scene",
        "description": "Elucim diagram or scene",
        "mimeType": "application/vnd.elucim.scene+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.elucim.scene",
          "conformsTo": ["public.json", "public.data"]
        }
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sethjuarez/elucim/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
