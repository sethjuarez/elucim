{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@elucim/dsl": ["../dsl/src/index.ts"],
      "@elucim/dsl/agent": ["../dsl/src/agent.ts"],
      "@elucim/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src", "../dsl/src", "../core/src"],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "../dsl/src/**/__tests__/**", "../dsl/src/**/*.test.ts", "../core/src/**/__tests__/**", "../core/src/**/*.test.ts", "../core/src/**/*.test.tsx"]
}
